<?xml version="1.0" encoding="utf-8"?>
<Application
    x:Class="Tdt.App.App"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <XamlControlsResources xmlns="using:Microsoft.UI.Xaml.Controls" />
            </ResourceDictionary.MergedDictionaries>

            <ResourceDictionary.ThemeDictionaries>
                <ResourceDictionary x:Key="Light">
                    <SolidColorBrush x:Key="DiffAddedBrush" Color="#0F7B0F" />
                    <SolidColorBrush x:Key="DiffRemovedBrush" Color="#C42B1C" />
                    <SolidColorBrush x:Key="DiffChangedBrush" Color="#9D5D00" />
                </ResourceDictionary>
                <ResourceDictionary x:Key="Dark">
                    <SolidColorBrush x:Key="DiffAddedBrush" Color="#6CCB5F" />
                    <SolidColorBrush x:Key="DiffRemovedBrush" Color="#FF99A4" />
                    <SolidColorBrush x:Key="DiffChangedBrush" Color="#FCD667" />
                </ResourceDictionary>
            </ResourceDictionary.ThemeDictionaries>

            <Style x:Key="CardBorderStyle" TargetType="Border">
                <Setter Property="Background" Value="{ThemeResource CardBackgroundFillColorDefaultBrush}" />
                <Setter Property="BorderBrush" Value="{ThemeResource CardStrokeColorDefaultBrush}" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="CornerRadius" Value="8" />
                <Setter Property="Padding" Value="16" />
            </Style>

            <Style x:Key="HintTextStyle" TargetType="TextBlock" BasedOn="{StaticResource CaptionTextBlockStyle}">
                <Setter Property="Foreground" Value="{ThemeResource TextFillColorSecondaryBrush}" />
                <Setter Property="TextWrapping" Value="Wrap" />
            </Style>

            <!-- Paths in dialogs: one line, ellipsis, full text in a tooltip. -->
            <DataTemplate x:Key="PathTemplate">
                <TextBlock
                    Text="{Binding}"
                    TextTrimming="CharacterEllipsis"
                    ToolTipService.ToolTip="{Binding}" />
            </DataTemplate>
        </ResourceDictionary>
    </Application.Resources>
</Application>
