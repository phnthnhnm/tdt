<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="Tdt.App.Views.AboutPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <ScrollViewer>
        <StackPanel Padding="24" Spacing="16">
            <TextBlock Text="About" Style="{StaticResource TitleTextBlockStyle}" />

            <Border Style="{StaticResource CardBorderStyle}">
                <StackPanel Spacing="8">
                    <TextBlock Text="Torrent Diff Tool" Style="{StaticResource SubtitleTextBlockStyle}" />
                    <TextBlock Text="{x:Bind ViewModel.VersionText}" />
                    <TextBlock Style="{StaticResource HintTextStyle}" Text="{x:Bind ViewModel.CopyrightText}" />
                    <TextBlock
                        Style="{StaticResource HintTextStyle}"
                        Text="Compares the file list of a new torrent with the archived torrent of the same name, then opens only the new files in qBittorrent." />
                </StackPanel>
            </Border>

            <Border Style="{StaticResource CardBorderStyle}">
                <StackPanel Spacing="12">
                    <TextBlock Text="Settings file" Style="{StaticResource SectionHeaderStyle}" />
                    <TextBlock
                        Text="{x:Bind ViewModel.SettingsPath}"
                        TextWrapping="Wrap"
                        IsTextSelectionEnabled="True" />
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <Button Content="Open settings folder" Command="{x:Bind ViewModel.OpenSettingsFolderCommand}" />
                        <Button Content="Source code" Command="{x:Bind ViewModel.OpenSourceCommand}" />
                    </StackPanel>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</Page>
