<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="Tdt.App.Views.DiffPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:muxc="using:Microsoft.UI.Xaml.Controls"
    xmlns:services="using:Tdt.App.Services"
    xmlns:viewModels="using:Tdt.App.ViewModels"
    Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">

    <Grid Padding="24" RowSpacing="16" RowDefinitions="Auto,Auto,*,Auto">

        <Grid Grid.Row="0" ColumnDefinitions="*,Auto" ColumnSpacing="16">
            <StackPanel Spacing="2" VerticalAlignment="Center">
                <TextBlock Text="Torrent Diff Tool" Style="{StaticResource TitleTextBlockStyle}" />
                <TextBlock
                    Style="{StaticResource HintTextStyle}"
                    Text="Compare a new torrent with the archived copy and open only the new files in qBittorrent." />
            </StackPanel>
            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                <Button Content="Report a bug" Click="OnReportBugClick" />
                <Button Content="Settings" Click="OnSettingsClick" />
            </StackPanel>
        </Grid>

        <Border Grid.Row="1" Style="{StaticResource CardBorderStyle}">
            <StackPanel Spacing="12">
                <TextBlock Text="New torrent" Style="{StaticResource SectionHeaderStyle}" />
                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                    <TextBox
                        IsReadOnly="True"
                        Text="{x:Bind ViewModel.NewTorrentPath, Mode=OneWay}"
                        PlaceholderText="No torrent selected" />
                    <Button
                        Grid.Column="1"
                        Content="Browse..."
                        Command="{x:Bind ViewModel.PickTorrentCommand}" />
                </Grid>

                <muxc:InfoBar
                    IsOpen="{x:Bind ViewModel.HasError, Mode=OneWay}"
                    Severity="Error"
                    Message="{x:Bind ViewModel.ErrorMessage, Mode=OneWay}"
                    IsClosable="False" />
                <muxc:InfoBar
                    IsOpen="{x:Bind ViewModel.HasStatus, Mode=OneWay}"
                    Severity="Success"
                    Message="{x:Bind ViewModel.StatusMessage, Mode=OneWay}"
                    IsClosable="False" />

                <StackPanel Orientation="Horizontal" Spacing="12">
                    <Button
                        Content="Compare torrents"
                        Command="{x:Bind ViewModel.CompareCommand}"
                        IsEnabled="{x:Bind ViewModel.CanCompare, Mode=OneWay}"
                        Style="{StaticResource AccentButtonStyle}" />
                    <ProgressRing
                        Width="20"
                        Height="20"
                        VerticalAlignment="Center"
                        IsActive="{x:Bind ViewModel.IsBusy, Mode=OneWay}" />
                </StackPanel>
            </StackPanel>
        </Border>

        <Border Grid.Row="2" Padding="0" Style="{StaticResource CardBorderStyle}">
            <Grid RowDefinitions="Auto,*">
                <Grid Padding="16,16,16,8" ColumnDefinitions="*,Auto">
                    <TextBlock
                        Margin="0"
                        VerticalAlignment="Center"
                        Style="{StaticResource SectionHeaderStyle}"
                        Text="Changes" />
                    <StackPanel
                        Grid.Column="1"
                        Orientation="Horizontal"
                        Spacing="12"
                        VerticalAlignment="Center"
                        Visibility="{x:Bind services:Ui.Visible(ViewModel.ShowResults), Mode=OneWay}">
                        <TextBlock
                            Foreground="{ThemeResource DiffAddedBrush}"
                            Text="{x:Bind ViewModel.AddedSummary, Mode=OneWay}" />
                        <TextBlock
                            Foreground="{ThemeResource DiffRemovedBrush}"
                            Text="{x:Bind ViewModel.RemovedSummary, Mode=OneWay}" />
                    </StackPanel>
                </Grid>

                <TextBlock
                    Grid.Row="1"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Style="{StaticResource HintTextStyle}"
                    Text="Select a torrent to see changes"
                    Visibility="{x:Bind services:Ui.Visible(ViewModel.ShowHint), Mode=OneWay}" />

                <TextBlock
                    Grid.Row="1"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Style="{StaticResource HintTextStyle}"
                    Text="No changes found."
                    Visibility="{x:Bind services:Ui.Visible(ViewModel.ShowEmptyResult), Mode=OneWay}" />

                <ListView
                    Grid.Row="1"
                    ItemsSource="{x:Bind ViewModel.Rows}"
                    SelectionMode="None"
                    Visibility="{x:Bind services:Ui.Visible(ViewModel.ShowResults), Mode=OneWay}">
                    <ListView.ItemTemplate>
                        <DataTemplate x:DataType="viewModels:DiffRow">
                            <Grid Padding="0,6" ColumnDefinitions="20,*" ColumnSpacing="10">
                                <SymbolIcon
                                    Symbol="Add"
                                    Foreground="{ThemeResource DiffAddedBrush}"
                                    Visibility="{x:Bind services:Ui.Visible(IsAdded)}" />
                                <SymbolIcon
                                    Symbol="Remove"
                                    Foreground="{ThemeResource DiffRemovedBrush}"
                                    Visibility="{x:Bind services:Ui.VisibleWhenFalse(IsAdded)}" />
                                <TextBlock
                                    Grid.Column="1"
                                    Text="{x:Bind Path}"
                                    TextTrimming="CharacterEllipsis"
                                    IsTextSelectionEnabled="True" />
                            </Grid>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>
            </Grid>
        </Border>

        <Button
            Grid.Row="3"
            HorizontalAlignment="Stretch"
            Content="Add to qBittorrent (select new files)"
            Command="{x:Bind ViewModel.AddToQBittorrentCommand}"
            IsEnabled="{x:Bind ViewModel.CanAdd, Mode=OneWay}"
            Style="{StaticResource AccentButtonStyle}"
            Visibility="{x:Bind services:Ui.Visible(ViewModel.HasAdded), Mode=OneWay}" />
    </Grid>
</Page>
