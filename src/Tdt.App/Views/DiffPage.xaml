<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="Tdt.App.Views.DiffPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:muxc="using:Microsoft.UI.Xaml.Controls"
    xmlns:services="using:Tdt.App.Services"
    xmlns:viewModels="using:Tdt.App.ViewModels"
    AllowDrop="True"
    NavigationCacheMode="Required"
    Background="Transparent"
    DragEnter="OnDragEnter"
    DragLeave="OnDragLeave"
    DragOver="OnDragOver"
    Drop="OnDrop">

    <Grid x:Name="RootGrid" Padding="24,16,24,24" RowSpacing="12" RowDefinitions="Auto,*,Auto">

        <Border Grid.Row="0" Style="{StaticResource CardBorderStyle}">
            <StackPanel Spacing="12">

                <StackPanel Spacing="2">
                    <TextBlock Style="{StaticResource BodyStrongTextBlockStyle}" Text="Release torrent" />
                    <TextBlock
                        Style="{StaticResource HintTextStyle}"
                        Text="Open or drop the new .torrent. The archived torrent of the same release is found in the data folder." />
                </StackPanel>

                <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="8">
                    <TextBox
                        IsReadOnly="True"
                        PlaceholderText="No torrent selected"
                        Text="{x:Bind ViewModel.NewTorrentPath, Mode=OneWay}" />
                    <Button
                        x:Name="BrowseButton"
                        Grid.Column="1"
                        Content="Browse..."
                        Command="{x:Bind ViewModel.PickTorrentCommand}">
                        <Button.KeyboardAccelerators>
                            <KeyboardAccelerator Modifiers="Control" Key="O" />
                        </Button.KeyboardAccelerators>
                    </Button>
                    <Button
                        Grid.Column="2"
                        Command="{x:Bind ViewModel.CompareCommand}"
                        Content="Compare"
                        IsEnabled="{x:Bind ViewModel.CanCompare, Mode=OneWay}"
                        Style="{StaticResource AccentButtonStyle}">
                        <Button.KeyboardAccelerators>
                            <KeyboardAccelerator Key="Enter" Modifiers="Control" />
                        </Button.KeyboardAccelerators>
                    </Button>
                </Grid>

                <TextBlock
                    Style="{StaticResource HintTextStyle}"
                    Text="{x:Bind ViewModel.ArchivedTorrentPath, Mode=OneWay}"
                    TextTrimming="CharacterEllipsis"
                    ToolTipService.ToolTip="{x:Bind ViewModel.ArchivedTorrentPath, Mode=OneWay}"
                    Visibility="{x:Bind services:Ui.Visible(ViewModel.HasArchivedTorrent), Mode=OneWay}" />

                <muxc:InfoBar
                    AutomationProperties.LiveSetting="Assertive"
                    IsClosable="False"
                    IsOpen="{x:Bind ViewModel.HasError, Mode=OneWay}"
                    Message="{x:Bind ViewModel.ErrorMessage, Mode=OneWay}"
                    Severity="Error" />

                <muxc:InfoBar
                    AutomationProperties.LiveSetting="Polite"
                    IsClosable="False"
                    IsOpen="{x:Bind ViewModel.HasStatus, Mode=OneWay}"
                    Message="{x:Bind ViewModel.StatusMessage, Mode=OneWay}"
                    Severity="Success" />

                <HyperlinkButton
                    Command="{x:Bind ViewModel.OpenQBittorrentCommand}"
                    Content="Open qBittorrent"
                    Visibility="{x:Bind services:Ui.Visible(ViewModel.CanOpenQBittorrent), Mode=OneWay}" />

                <StackPanel
                    Orientation="Horizontal"
                    Spacing="10"
                    Visibility="{x:Bind services:Ui.Visible(ViewModel.HasProgress), Mode=OneWay}">
                    <ProgressRing
                        Width="16"
                        Height="16"
                        VerticalAlignment="Center"
                        IsActive="{x:Bind ViewModel.IsBusy, Mode=OneWay}" />
                    <TextBlock
                        VerticalAlignment="Center"
                        Style="{StaticResource HintTextStyle}"
                        Text="{x:Bind ViewModel.ProgressMessage, Mode=OneWay}" />
                </StackPanel>
            </StackPanel>
        </Border>

        <Border Grid.Row="1" Padding="0" Style="{StaticResource CardBorderStyle}">
            <Grid RowDefinitions="Auto,*">
                <Grid Padding="16,12" ColumnDefinitions="*,Auto">
                    <TextBlock
                        VerticalAlignment="Center"
                        Style="{StaticResource BodyStrongTextBlockStyle}"
                        Text="Changes" />
                    <StackPanel
                        Grid.Column="1"
                        VerticalAlignment="Center"
                        Orientation="Horizontal"
                        Spacing="12">
                        <TextBlock
                            VerticalAlignment="Center"
                            Style="{StaticResource HintTextStyle}"
                            Text="{x:Bind ViewModel.Summary, Mode=OneWay}"
                            Visibility="{x:Bind services:Ui.Visible(ViewModel.ShowResults), Mode=OneWay}" />
                        <Button
                            Command="{x:Bind ViewModel.ClearCommand}"
                            Content="Clear"
                            Visibility="{x:Bind services:Ui.Visible(ViewModel.HasNewTorrent), Mode=OneWay}">
                            <Button.KeyboardAccelerators>
                                <KeyboardAccelerator Key="Escape" />
                            </Button.KeyboardAccelerators>
                        </Button>
                    </StackPanel>
                </Grid>

                <StackPanel
                    Grid.Row="1"
                    MaxWidth="420"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Spacing="10"
                    Visibility="{x:Bind services:Ui.Visible(ViewModel.ShowWelcome), Mode=OneWay}">
                    <FontIcon
                        FontSize="28"
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        Glyph="&#xE896;" />
                    <TextBlock
                        Text="Open or drop a .torrent to compare it with the archived copy of the release"
                        TextAlignment="Center"
                        Style="{StaticResource BodyTextBlockStyle}" />
                </StackPanel>

                <TextBlock
                    Grid.Row="1"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Style="{StaticResource HintTextStyle}"
                    Text="No changes found. The release matches the archived torrent."
                    Visibility="{x:Bind services:Ui.Visible(ViewModel.ShowEmptyResult), Mode=OneWay}" />

                <ListView
                    Grid.Row="1"
                    AutomationProperties.Name="Changed files"
                    ItemsSource="{x:Bind ViewModel.Rows}"
                    SelectionMode="None"
                    Visibility="{x:Bind services:Ui.Visible(ViewModel.ShowResults), Mode=OneWay}">
                    <ListView.ItemTemplate>
                        <DataTemplate x:DataType="viewModels:DiffRow">
                            <Grid
                                Padding="0,6"
                                AutomationProperties.Name="{x:Bind AutomationName}"
                                ColumnDefinitions="24,*,Auto"
                                ColumnSpacing="8">
                                <FontIcon
                                    FontSize="14"
                                    Foreground="{ThemeResource DiffAddedBrush}"
                                    Glyph="&#xE710;"
                                    Visibility="{x:Bind services:Ui.Visible(IsAdded)}" />
                                <FontIcon
                                    FontSize="14"
                                    Foreground="{ThemeResource DiffRemovedBrush}"
                                    Glyph="&#xE738;"
                                    Visibility="{x:Bind services:Ui.Visible(IsRemoved)}" />
                                <FontIcon
                                    FontSize="14"
                                    Foreground="{ThemeResource DiffChangedBrush}"
                                    Glyph="&#xE70F;"
                                    Visibility="{x:Bind services:Ui.Visible(IsChanged)}" />
                                <TextBlock
                                    Grid.Column="1"
                                    VerticalAlignment="Center"
                                    IsTextSelectionEnabled="True"
                                    Text="{x:Bind Path}"
                                    TextTrimming="CharacterEllipsis"
                                    ToolTipService.ToolTip="{x:Bind Path}" />
                                <StackPanel
                                    Grid.Column="2"
                                    HorizontalAlignment="Right"
                                    Orientation="Horizontal"
                                    Spacing="8">
                                    <TextBlock
                                        MinWidth="72"
                                        VerticalAlignment="Center"
                                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                        Style="{StaticResource CaptionTextBlockStyle}"
                                        Text="{x:Bind SizeText}"
                                        TextAlignment="Right" />
                                    <TextBlock
                                        MinWidth="56"
                                        VerticalAlignment="Center"
                                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                        Style="{StaticResource CaptionTextBlockStyle}"
                                        Text="{x:Bind DeltaText}"
                                        TextAlignment="Right" />
                                </StackPanel>
                            </Grid>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>
            </Grid>
        </Border>

        <StackPanel
            Grid.Row="2"
            Spacing="8"
            Visibility="{x:Bind services:Ui.Visible(ViewModel.HasDownloads), Mode=OneWay}">
            <TextBlock
                HorizontalAlignment="Center"
                Style="{StaticResource HintTextStyle}"
                Text="{x:Bind ViewModel.DownloadSummary, Mode=OneWay}" />
            <Button
                HorizontalAlignment="Stretch"
                Command="{x:Bind ViewModel.AddToQBittorrentCommand}"
                Content="Add to qBittorrent (paused)"
                IsEnabled="{x:Bind ViewModel.CanAdd, Mode=OneWay}"
                Style="{StaticResource AccentButtonStyle}" />
        </StackPanel>

        <Border
            x:Name="DropOverlay"
            Grid.RowSpan="3"
            Margin="4"
            Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
            BorderBrush="{ThemeResource AccentFillColorDefaultBrush}"
            BorderThickness="2"
            CornerRadius="8"
            IsHitTestVisible="False"
            Visibility="Collapsed">
            <StackPanel
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Spacing="10">
                <FontIcon FontSize="28" Glyph="&#xE896;" />
                <TextBlock Style="{StaticResource SubtitleTextBlockStyle}" Text="Drop the .torrent to compare" />
                <TextBlock
                    HorizontalAlignment="Center"
                    Style="{StaticResource HintTextStyle}"
                    Text="The archived copy is located automatically." />
            </StackPanel>
        </Border>
    </Grid>
</Page>
