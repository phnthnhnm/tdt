<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="Tdt.App.Views.QBittorrentPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:muxc="using:Microsoft.UI.Xaml.Controls">

    <ScrollViewer>
        <StackPanel Padding="24" Spacing="16">
            <TextBlock Text="qBittorrent" Style="{StaticResource TitleTextBlockStyle}" />

            <Border Style="{StaticResource CardBorderStyle}">
                <StackPanel Spacing="12">
                    <TextBlock Text="WebUI connection" Style="{StaticResource SectionHeaderStyle}" />
                    <Grid ColumnDefinitions="*,120" ColumnSpacing="8">
                        <TextBox
                            Header="Host"
                            PlaceholderText="127.0.0.1"
                            Text="{x:Bind ViewModel.Host, Mode=TwoWay}" />
                        <TextBox
                            Grid.Column="1"
                            Header="Port"
                            InputScope="Number"
                            Text="{x:Bind ViewModel.Port, Mode=TwoWay}" />
                    </Grid>
                    <TextBox Header="Username" Text="{x:Bind ViewModel.Username, Mode=TwoWay}" />
                    <PasswordBox Header="Password" Password="{x:Bind ViewModel.Password, Mode=TwoWay}" />
                    <PasswordBox
                        Header="API key (qBittorrent 5.2+)"
                        PlaceholderText="Optional; replaces the username and password"
                        Password="{x:Bind ViewModel.ApiKey, Mode=TwoWay}" />
                    <ToggleSwitch
                        Header="Use HTTPS"
                        IsOn="{x:Bind ViewModel.UseHttps, Mode=TwoWay}" />
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <Button
                            Content="Save"
                            Command="{x:Bind ViewModel.SaveQBittorrentCommand}"
                            Style="{StaticResource AccentButtonStyle}" />
                        <Button Content="Clear API key" Command="{x:Bind ViewModel.ClearApiKeyCommand}" />
                    </StackPanel>
                </StackPanel>
            </Border>

            <Border Style="{StaticResource CardBorderStyle}">
                <StackPanel Spacing="12">
                    <TextBlock Text="Blacklist" Style="{StaticResource SectionHeaderStyle}" />
                    <TextBlock
                        Style="{StaticResource HintTextStyle}"
                        Text="Files whose path contains one of these substrings are never selected." />
                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                        <TextBox
                            PlaceholderText="Add a substring"
                            Text="{x:Bind ViewModel.NewBlacklistEntry, Mode=TwoWay}" />
                        <Button
                            Grid.Column="1"
                            Content="Add"
                            Command="{x:Bind ViewModel.AddBlacklistEntryCommand}" />
                    </Grid>
                    <ListView
                        MaxHeight="220"
                        ItemsSource="{x:Bind ViewModel.Blacklist}"
                        SelectionMode="None">
                        <ListView.ItemTemplate>
                            <DataTemplate x:DataType="x:String">
                                <Grid Padding="0,4" ColumnDefinitions="*,Auto" ColumnSpacing="8">
                                    <TextBlock
                                        VerticalAlignment="Center"
                                        Text="{x:Bind}"
                                        IsTextSelectionEnabled="True" />
                                    <Button
                                        Grid.Column="1"
                                        Content="Remove"
                                        Tag="{x:Bind}"
                                        Click="OnRemoveBlacklistEntryClick" />
                                </Grid>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                </StackPanel>
            </Border>

            <muxc:InfoBar
                IsOpen="{x:Bind ViewModel.HasStatus, Mode=OneWay}"
                Severity="Informational"
                Message="{x:Bind ViewModel.StatusMessage, Mode=OneWay}"
                IsClosable="False" />
        </StackPanel>
    </ScrollViewer>
</Page>
